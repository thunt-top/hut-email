# This file carries optional environment overrides only.
# Required settings live in config/config.toml (committed) and
# config/secret.toml (gitignored; copy config/secret.example.toml and fill
# in your Tencent Cloud credentials).

# Optional: listen address, overrides listen_addr from config/config.toml.
LISTEN_ADDR=0.0.0.0:39788

# Optional: config directory (default: config/, containing config.toml,
# secret.toml and email_map.toml).
CONFIG_DIR=config

# Log verbosity (tracing EnvFilter syntax).
RUST_LOG=info
